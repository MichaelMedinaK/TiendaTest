# Conexion a PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tienda_test?schema=public"

# Conexion directa para migraciones/db push (en local, igual a DATABASE_URL).
# En Supabase usa la conexion directa o "Session pooler" (puerto 5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tienda_test?schema=public"

# Solo para "npm run db:copy-products": copia el catalogo de productos de una base a otra.
# Dejalas vacias si no vas a copiar productos entre bases.
SOURCE_DATABASE_URL=""
TARGET_DATABASE_URL=""

# Clave de firma del JWT de sesion (minimo 32 caracteres en produccion)
AUTH_SECRET="cambia-esta-clave-por-una-de-al-menos-32-caracteres"

# Horas de vigencia de la cookie de sesion
AUTH_TOKEN_TTL_HOURS="8"

# Credenciales obligatorias del administrador maestro inicial creado por "npm run db:seed".
# Usa una contraseña unica de al menos 12 caracteres.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador Principal"

# Crear productos de demostracion durante el seed ("true" o "false")
SEED_DEMO_PRODUCTS="true"

# Zona horaria usada para formatear fechas en servidor y navegador
NEXT_PUBLIC_STORE_TIME_ZONE="America/Lima"

# Simbolo de moneda mostrado en la interfaz
NEXT_PUBLIC_CURRENCY_SYMBOL="S/"

# Tarifa del delivery por kilometro (el precio del envio es kilometros x tarifa)
NEXT_PUBLIC_DELIVERY_RATE_PER_KM="1700"
